# The MVP runs with deterministic mock cognitive workers by default.
# To point a worker at an OpenAI-compatible local inference server, set:
# WORKER_BACKEND=openai_compatible
# MODEL_BASE_URL=http://host.docker.internal:11434/v1
# MODEL_NAME=qwen3.5:4b
# MODEL_API_KEY=unused

MEMORY_DATABASE=/data/cognition.db
