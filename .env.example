MEMORY_DATABASE=/data/cognition.db

# Docker Compose starts a live Ollama provider and pulls this model before the
# cognitive workers become ready. Use an instruct model that supports JSON output.
OLLAMA_MODEL=llama3.2:3b

# Override any one worker to use another OpenAI-compatible provider/model.
# LEFT_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# LEFT_MODEL_NAME=llama3.2:3b
# LEFT_MODEL_API_KEY=unused
# LEFT_MODEL_TIMEOUT_SECONDS=150
# LEFT_MODEL_MAX_TOKENS=220
# LEFT_MODEL_OUTPUT_ATTEMPTS=2
# RIGHT_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# RIGHT_MODEL_NAME=llama3.2:3b
# RIGHT_MODEL_API_KEY=unused
# RIGHT_MODEL_TIMEOUT_SECONDS=150
# RIGHT_MODEL_MAX_TOKENS=200
# RIGHT_MODEL_OUTPUT_ATTEMPTS=2
# EXEC_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# EXEC_MODEL_NAME=llama3.2:3b
# EXEC_MODEL_API_KEY=unused
# EXEC_MODEL_TIMEOUT_SECONDS=150
# EXEC_MODEL_MAX_TOKENS=260
# EXEC_MODEL_OUTPUT_ATTEMPTS=2
