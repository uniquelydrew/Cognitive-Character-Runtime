MEMORY_DATABASE=/data/cognition.db

# Required. Generate a unique value before starting the stack, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# The UI's nginx proxy supplies this to the local API; direct API callers must
# send it as X-API-Key. Never commit the real value.
API_AUTH_TOKEN=

# Docker Compose starts a live Ollama provider and pulls this model before the
# cognitive workers become ready. Use an instruct model that supports JSON output.
OLLAMA_MODEL=llama3.2:3b

# On an NVIDIA-enabled Docker host, add docker-compose.gpu.yml to route the
# default shared Ollama provider to the GPU.

# Override any one worker to use another OpenAI-compatible provider/model.
# LEFT_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# LEFT_MODEL_NAME=llama3.2:3b
# LEFT_MODEL_API_KEY=unused
# LEFT_MODEL_TIMEOUT_SECONDS=40
# LEFT_MODEL_MAX_TOKENS=160
# LEFT_MODEL_OUTPUT_ATTEMPTS=2
# RIGHT_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# RIGHT_MODEL_NAME=llama3.2:3b
# RIGHT_MODEL_API_KEY=unused
# RIGHT_MODEL_TIMEOUT_SECONDS=40
# RIGHT_MODEL_MAX_TOKENS=160
# RIGHT_MODEL_OUTPUT_ATTEMPTS=2
# EXEC_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# EXEC_MODEL_NAME=llama3.2:3b
# EXEC_MODEL_API_KEY=unused
# EXEC_MODEL_TIMEOUT_SECONDS=40
# EXEC_MODEL_MAX_TOKENS=220
# Extra deliberation budget for repeated questions. This applies only to the
# Executive's internal repeat-assessment and its resulting response.
# EXEC_REPEAT_MAX_TOKENS=360
# EXEC_REPEAT_TEMPERATURE=0.32
# EXEC_MODEL_OUTPUT_ATTEMPTS=2
# WORKER_REQUEST_TIMEOUT_SECONDS=90
# TURN_TIMEOUT_SECONDS=240
# SESSION_QUEUE_TIMEOUT_SECONDS=15
# Bound simultaneous full turns so local GPUs cannot be exhausted by browser
# retries or multiple tabs. Additional requests receive a retryable 429.
# MAX_CONCURRENT_TURNS=2
# Keep false outside explicit local diagnostics. Debug output contains full
# conversations, model artifacts, and mutation history.
# ENABLE_DEBUG_API=false

# Optional independent GPU inference providers. Start with:
# docker compose -f docker-compose.yml -f docker-compose.dedicated-providers.yml up --build -d
# This permits left, right, and executive inference to run on separate Ollama
# schedulers, but may keep three models in GPU memory. It requires an
# NVIDIA-enabled Docker daemon.
# DEDICATED_OLLAMA_KEEP_ALIVE=10m
